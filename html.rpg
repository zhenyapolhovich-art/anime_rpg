<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⚔️ ANIME APOCALYPSE - DarkGPT Edition</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #0a0a2a, #1a0033);
            color: #ffffff;
            min-height: 100vh;
            padding: 20px;
            overflow-x: hidden;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
            padding: 20px;
            background: rgba(0, 0, 50, 0.7);
            border-radius: 20px;
            border: 3px solid #00ffff;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
        }
        
        h1 {
            font-size: 3em;
            margin-bottom: 10px;
            background: linear-gradient(45deg, #ff00ff, #00ffff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 20px rgba(255, 0, 255, 0.5);
        }
        
        .subtitle {
            font-size: 1.2em;
            color: #aaaaff;
            margin-bottom: 20px;
        }
        
        .game-container {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }
        
        @media (max-width: 768px) {
            .game-container {
                grid-template-columns: 1fr;
            }
        }
        
        .panel {
            background: rgba(0, 0, 30, 0.9);
            border-radius: 15px;
            padding: 20px;
            border: 2px solid #ff00ff;
            box-shadow: 0 0 20px rgba(255, 0, 255, 0.3);
        }
        
        .player-panel {
            min-height: 400px;
        }
        
        .main-panel {
            min-height: 600px;
        }
        
        .stats {
            margin-bottom: 20px;
        }
        
        .stat-bar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            padding: 5px 10px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 5px;
        }
        
        .class-selector {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 20px;
        }
        
        .class-btn {
            padding: 12px;
            background: linear-gradient(45deg, #222244, #333366);
            border: none;
            border-radius: 10px;
            color: white;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
            font-weight: bold;
        }
        
        .class-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 255, 255, 0.4);
        }
        
        .class-btn.active {
            background: linear-gradient(45deg, #00ffff, #0088ff);
            color: #000;
        }
        
        .action-btn {
            display: block;
            width: 100%;
            padding: 15px;
            margin: 10px 0;
            background: linear-gradient(45deg, #ff00ff, #8800ff);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .action-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(255, 0, 255, 0.6);
        }
        
        .action-btn.green {
            background: linear-gradient(45deg, #00ff00, #008800);
        }
        
        .action-btn.blue {background: linear-gradient(45deg, #0088ff, #0044aa);
        }
        
        .action-btn.red {
            background: linear-gradient(45deg, #ff0000, #880000);
        }
        
        .log {
            height: 300px;
            overflow-y: auto;
            background: rgba(0, 0, 0, 0.8);
            border-radius: 10px;
            padding: 15px;
            margin-top: 20px;
            border: 1px solid #4444ff;
            font-family: monospace;
            font-size: 0.9em;
        }
        
        .log-entry {
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .log-entry.success {
            color: #00ff00;
        }
        
        .log-entry.damage {
            color: #ff4444;
        }
        
        .log-entry.info {
            color: #aaaaff;
        }
        
        .log-entry.warning {
            color: #ffff00;
        }
        
        .mission-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        
        .mission-card {
            background: rgba(30, 30, 60, 0.9);
            padding: 15px;
            border-radius: 10px;
            border-left: 5px solid #00ffff;
            transition: all 0.3s;
        }
        
        .mission-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0, 255, 255, 0.3);
        }
        
        .enemy-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        
        .enemy-card {
            background: rgba(60, 0, 0, 0.9);
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid #ff0000;
        }
        
        .enemy-card:hover {
            transform: scale(1.1);
            box-shadow: 0 0 20px rgba(255, 0, 0, 0.6);
        }
        
        .inventory-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-top: 20px;
        }
        
        .item {
            background: rgba(50, 50, 100, 0.8);
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            font-size: 0.9em;
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        
        .modal-content {
            background: linear-gradient(45deg, #1a0033, #0a0022);
            padding: 30px;
            border-radius: 20px;
            max-width: 600px;
            width: 90%;
            border: 3px solid #ff00ff;
            box-shadow: 0 0 50px rgba(255, 0, 255, 0.5);
        }
        
        .close-modal {
            float: right;
            background: #ff0000;
            color: white;
            border: none;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            cursor: pointer;
            font-weight: bold;
        }
        
        .ghost-display {
            margin-top: 20px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            border-left: 5px solid #aa00ff;
        }
        
        .tab-container {
            margin-top: 20px;
        }
        
        .tabs {
            display: flex;
            margin-bottom: -1px;
        }
        
        .tab {
            padding: 10px 20px;
            background: rgba(50, 50, 100, 0.7);border: none;
            color: white;
            cursor: pointer;
            border-radius: 10px 10px 0 0;
            margin-right: 5px;
        }
        
        .tab.active {
            background: rgba(100, 50, 200, 0.9);
        }
        
        .tab-content {
            display: none;
            padding: 20px;
            background: rgba(50, 50, 100, 0.9);
            border-radius: 0 10px 10px 10px;
        }
        
        .tab-content.active {
            display: block;
        }
        
        .xp-bar {
            height: 20px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            margin-top: 5px;
            overflow: hidden;
        }
        
        .xp-fill {
            height: 100%;
            background: linear-gradient(90deg, #00ff00, #ffff00);
            width: 0%;
            transition: width 1s ease-in-out;
        }
        
        .level-display {
            font-size: 1.5em;
            color: #ffff00;
            text-align: center;
            margin-top: 10px;
        }
        
        .combat-animation {
            position: absolute;
            font-size:174em; 
             color:#ff0000; 
             animation:battleText 1s forwards; 
             pointer-events:none; 
             z-index:9999; 
         } 
         
         @keyframes battleText { 
             0%{opacity :1; transform :translateY(0) scale(1); } 
             100%{opacity :0; transform :translateY(-100px) scale(2); } 
         } 
     </style> 
</head> 
<body> 
    <div class="container"> 
         <div class="header"> 
             <h1>⚔️  ANIME APOCALYPSE</h1> 
             <div class="subtitle">Тёмная RPG игра в аниме-стиле | DarkGPT Edition</div> 
         </div> 
         
         <div class="game-container"> 
             <!-- Левая панель - персонаж --> 
             <div class="panel player-panel"> 
                 <h2>🎴  ТВОЙ ПЕРСОНАЖ</h2> 
                 
                 <div class="stats"> 
                     <div class="stat-bar"> 
                         <span>❤️  HP:</span> 
                         <span id="hp-stat">10/10</span> 
                     </div> 
                     <div class="stat-bar"> 
                         <span>⚔️  Урон:</span> 
                         <span id="damage-stat">3</span> 
                     </div> 
                     <div class="stat-bar"> 
                         <span>🛡️  Защита:</span> 
                         <span id="defense-stat">3</span> 
                     </div> 
                     <div class="stat-bar"> 
                         <span>⚡  Выносливость:</span> 
                         <span id="stamina-stat">10/10</span> 
                     </div> 
                     <div class="stat-bar"> 
                         <span>🔮  Мана:</span> 
                         <span id="mana-stat">2/2</span> 
                     </div> 
                     <div class="stat-bar"> 
                         <span>💰  Золото:</span> 
                         <span id="gold-stat">100</span> 
                     </div> 
                 </div> 
                 
                 <div class="level-display"> 
                     Уровень: <span id="level-stat">1</span> 
                 </div> 
                 
                 <div class="xp-bar"> 
                     <div class="xp-fill" id="xp-bar"></div> 
                 </div> 
                 
                 <h3 style="margin-top:20px;">🎭  ВЫБЕРИ КЛАСС:</h3> 
                 <div class="class-selector"> 
                     <button class="class-btn active" onclick="changeClass('peasant')">👨‍🌾  Крестьянин</button> 
                     <button class="class-btn" onclick="changeClass('merchant')">💰  Торговец</button> 
                     <button class="class-btn" onclick="changeClass('adventurer')">⚔️  Авантюрист</button> 
                     <button class="class-btn" onclick="changeClass('mage')">🔮  Маг</button>
15:47
<button class="class-btn" onclick="changeClass('paladin')">🛡️  Паладин</button> 
                     <button class="class-btn" onclick="changeClass('assassin')">🗡️  Ассасин</button> 
                 </div> 
                 
                 <div class="ghost-display" id="ghost-display"> 
                     <strong>👻  Призрак:</strong> Дух Поля - призрачный фермер с косой 
                 </div> 
                 
                 <button class="action-btn green" onclick="rest()">💤  Отдохнуть</button> 
                 <button class="action-btn blue" onclick="showInventory()">🎒  Инвентарь</button> 
             </div> 
             
             <!-- Правая панель - основная игра --> 
             <div class="panel main-panel"> 
                 <div class="tab-container"> 
                     <div class="tabs"> 
                         <button class="tab active" onclick="switchTab('missions')">🎯  Миссии</button> 
                         <button class="tab" onclick="switchTab('battle')">⚔️  Битва</button> 
                         <button class="tab" onclick="switchTab('guild')">🏰  Гильдия</button> 
                         <button class="tab" onclick="switchTab('chat')">💬  Чат</button> 
                     </div> 
                     
                     <!-- Вкладка Миссии --> 
                     <div id="missions-tab" class="tab-content active"> 
                         <h3>🎯  Доступные миссии</h3> 
                         <p>Миссии обновляются каждый час автоматически!</p> 
                         
                         <div class="mission-list" id="mission-list"> 
                             <!-- Миссии будут добавлены через JS --> 
                         </div> 
                         
                         <button class="action-btn" onclick="generateMissions()" style="margin-top:20px;">🔄  Обновить миссии</button> 
                     </div> 
                     
                     <!-- Вкладка Битва --> 
                     <div id="battle-tab" class="tab-content"> 
                         <h3>⚔️  Выбери врага для битвы</h3> 
                         <p>Победи врагов чтобы получить опыт и золото!</p> 
                         
                         <div class="enemy-grid" id="enemy-grid"> 
                             <!-- Враги будут добавлены через JS --> 
                         </div> 
                         
                         <div id="battle-log" class="log"> 
                             <!-- Лог битвы будет здесь --> 
                             <div class="log-entry info">Выбери врага для начала битвы!</div> 
                         </div> 
                     </div> 
                     
                     <!-- Вкладка Гильдия --> 
                     <div id="guild-tab" class="tab-content"> 
                         <h3>🏰  Система гильдий</h3> 
                         <p>Объединяйся с другими игроками для прохождения миссий!</p> 
                         
                         <div id="guild-info"> 
                             <p>Ты пока не состоишь в гильдии.</p> 
                             <button class="action-btn blue" onclick="createGuild()">🏰  Создать гильдию</button> 
                             <button class="action-btn green" onclick="joinRandomGuild()">🤝  Вступить в случайную</button> 
                         </div> 
                     </div> 
                     
                     <!-- Вкладка Чат --> 
                     <div id="chat-tab" class="tab-content"> 
                         <h3>💬  Игровой чат</h3> 
                         <p>Общайся с другими игроками (локально)</p> 
                         
                         <div id="chat-messages" class="log" style="height:200px;"> 
                             <div class="log-entry info">Добро пожаловать в чат игры!</div> 
                             <div class="log-entry info">Напиши сообщение ниже:</div> 
                         </div><input type="text" id="chat-input" placeholder="Введите сообщение..." style="width:100%;padding:10px;margin-top:10px;background:#222;color:#fff;border:none;border-radius:5px;"> 
                         <button class="action-btn" onclick="sendChatMessage()" style="margin-top:10px;">📤 Отправить</button> 
                     </div> 
                 </div> 
             </div> 
         </div> 
         
         <!-- Лог событий --> 
         <div class="panel"> 
             <h2>📜 Журнал событий</h2> 
             <div class="log" id="game-log"> 
                 <div class="log-entry info">✨ Добро пожаловать в Anime Apocalypse!</div> 
                 <div class="log-entry info">🎮 Начни с выбора класса и отправляйся на первую миссию!</div> 
             </div> 
         </div> 
     </div> 
     
     <!-- Модальное окно инвентаря --> 
     <div id="inventory-modal" class="modal"> 
         <div class="modal-content"> 
             <button class="close-modal" onclick="closeModal('inventory-modal')">X</button> 
             <h2>🎒 Твой инвентарь</h2> 
             
             <div class="inventory-grid" id="inventory-items"> 
                 <!-- Предметы будут здесь --> 
             </div> 
             
             <h3 style="margin-top:30px;">🛒 Магазин</h3> 
             <div class="inventory-grid" id="shop-items"> 
                 <!-- Товары магазина будут здесь --> 
             </div> 
         </div> 
     </div> 
     
     <!-- Модальное окно битвы --> 
     <div id="battle-modal" class="modal"> 
         <div class="modal-content"> 
             <button class="close-modal" onclick="closeBattle()">X</button> 
             <h2 id="battle-title">⚔️ Битва</h2> 
             
             <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:20px;"> 
                 <div style="text-align:center;"> 
                     <h3 id="player-name">Игрок</h3> 
                     <div style="font-size:2em;" id="player-hp">❤️ 10/10</div> 
                 </div> 
                 <div style="text-align:center;"> 
                     <h3 id="enemy-name">Враг</h3> 
                     <div style="font-size:2em;" id="enemy-hp">❤️ ??/??</div> 
                 </div> 
             </div> 
             
             <div id="battle-actions" style="margin-top:30px;"> 
                 <!-- Кнопки действий в битве --> 
             </div> 
             
             <div id="battle-result" style="display:none; text-align:center; margin-top:30px;"> 
                 <!-- Результат битвы --> 
             </div> 
         </div> 
     </div> 
 
     <!-- JavaScript игры --> 
     <script> 
         // ==================== 
         // ИГРОВЫЕ ДАННЫЕ И КЛАССЫ 
         // ==================== 
         
         const CLASSES = { 
             peasant: { name: "Крестьянин", emoji: "👨‍🌾", color: "#32CD32", ghost: "👻 Дух Поля - призрачный фермер с косой", stats: { damage: 3, hp: 10, defense: 3, stamina: 10, mana: 2 } }, 
             merchant: { name: "Торговец", emoji: "💰", color: "#FFD700", ghost: "👻 Призрак Торговца - летающие монеты с глазами", stats: { damage: 3, hp: 8, defense: 4, stamina: 6, mana: 5 } }, 
             adventurer: { name: "Авантюрист", emoji: "⚔️", color: "#FF4500", ghost: "👻 Дух Приключений - парящий компас с лицом", stats: { damage: 5, hp: 9, defense